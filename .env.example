ANTHROPIC_API_KEY=

# Modelo usado por padrão (claude-haiku-4-5 ou claude-sonnet-5)
CLAUDE_MODEL=claude-haiku-4-5

# Número máximo de chamadas pagas permitidas antes do limitador local bloquear
# novas requisições. Apague contador_chamadas.json para zerar a contagem.
LIMITE_CHAMADAS=5

# TRAVA DE SEGURANÇA — mantenha "false" até decidir deliberadamente autorizar
# uma chamada real (paga) à API da Anthropic. Enquanto "false", o backend
# bloqueia QUALQUER chamada ao SDK da Anthropic antes mesmo de instanciá-lo.
# Só mude para "true" manualmente, sabendo que isso vai gerar custo real.
ENABLE_PAID_API_CALLS=false
